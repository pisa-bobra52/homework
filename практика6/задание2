num = int(input("Введите число от 0 до 36:"))

if num ==0 :
    print("Карман зеленый")

elif (1 <= num <= 10) or (19 <=  num <= 28):

    print("Карман черный" if num % 2 ==0 else "Карман красный")

elif (11 <= num <= 18) or (29 <= num <= 36):

    print("Карман красный" if num % 2 ==0 else "Карман красный")

else:
    print("Oшибка ввода, введите число в диапозоне от 0 до 36")
