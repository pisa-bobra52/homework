клетка1 = int(input("Введите первую клетку от 1 до 8:"))
строка1 = int(input("Введите первый столбец от 1 до 8:"))

клетка2 = int(input("Введите вторую клетку от 1 до 8:"))
строка2 = int(input("Введите второй столбец от 1 до 8:"))

color1 = (клетка1 + строка1) % 2
color2 = (клетка2 + строка2) % 2

if color1 == color2:
    print("YES")
else:
    print("NO")
