def get_number(prompt):
    while True:
        value = input(prompt)
        try:
            return int(value)
        except ValueError:
            print(f"Ошибка: '{value}' не является целым числом. Попробуйте ещё раз.")


num1 = get_number("Введите первое число: ")
num2 = get_number("Введите второе число: ")

result = num1 + num2
print(f"Сумма: {num1} + {num2} = {result}")
