#переменные
m = int(input("cтартовое количество организмов:"))
p = int(input("среднесуточное увеличение в процентах:"))
n = int(input("количество дней для размножения:"))
num = 0
#перебирает дни с 1 по n
for i in range(1, n+1):
    #количество организмов к следующему дню.
    m = m * (m+ p / 100)
    num += 1
    #выводит номер дня и текущее количество организмов
    print(f" {num}  {m:.2f} ")
