power_to_base = {i ** 5: i for i in range( 1, 151)}   # пятая степень -> основание
powers = [0] + [i ** 5 for i in range( 1, 151)]       # индекс -> пятая степень

found = False
for e in range( 1, 151):
    e5 = powers[e]
    a = 1
    while a < e and not found:
        b = a
        while b < e and not found:
            if powers[a] + powers[b] >= e5:
                break
            c = b
            while c < e and not found:
                rem = e5 - powers[a] - powers[b] - powers[c]
                d = power_to_base.get( rem) if rem >= 0 else None
                if d is not None and d >= c:
                    print( a + b + c + d + e)
                    found = True
                    break
                c += 1
            b += 1
        a += 1
