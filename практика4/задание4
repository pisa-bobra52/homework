#школьники
n = int(input())

#мандаринки
k = int(input())

#сколько раз по n мандаринок можно раздать целиком
each_gets = k // n

#остаток — мандарнок без деления
left_in_basket = k % n

#вводим результат, сколько отсанется магдаринов, и сколько останется в ведре
print(each_gets)
print(left_in_basket)
